# ── Google AI (Gemini + Veo + TTS – one key for everything) ──────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# Models
GEMINI_SCRIPT_MODEL=gemini-2.5-flash
# Imagen for keyframes. ULTRA renders text/formulas (CO2, F=ma) far more reliably.
# Use imagen-4.0-generate-001 for higher throughput / lower cost.
GEMINI_IMAGE_MODEL=imagen-4.0-ultra-generate-001
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
VEO_MODEL=veo-3.0-generate-001

# TTS voice (Charon=deep dramatic male, Kore=calm female, Fenrir=intense male)
GEMINI_TTS_VOICE=Charon

# ── Veo service account (Vertex AI fallback if API key quota exceeded) ────────
VEO_SERVICE_ACCOUNT_PATH=credentials/veo-service-account.json
VEO_PROJECT_ID=veo-test-487816
VEO_LOCATION=us-central1

# ── YouTube Data API ──────────────────────────────────────────────────────────
# Enable YouTube Data API v3 at console.cloud.google.com → APIs & Services
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# OAuth2 for upload (download client_secrets.json from Google Cloud Console → OAuth 2.0)
YOUTUBE_CLIENT_SECRETS_PATH=credentials/client_secrets.json
YOUTUBE_TOKEN_PATH=credentials/youtube_token.json

# ── Pipeline settings ─────────────────────────────────────────────────────────
NICHE_KEYWORDS=dark history,untold history,hidden secrets,mysterious facts
TOP_TRENDS_COUNT=1
TARGET_VIDEO_DURATION=90

OUTPUT_DIR=output
BGM_DIR=assets/bgm
BRAND_GUIDELINES_PDF=config/brand_guidelines.pdf

# ── YouTube upload ────────────────────────────────────────────────────────────
YT_CATEGORY_ID=27
YT_DEFAULT_LANGUAGE=en
YT_PRIVACY_STATUS=public

# ── Auth (web product accounts) ─────────────────────────────────────────────
# Shared code required to sign up. Change it; share with your team. Rotate if it leaks.
SIGNUP_INVITE_CODE=change-me-team-code
# Comma-separated emails granted the admin role on signup (admins see all jobs).
ADMIN_EMAILS=you@dextora.ai
# JWT signing secret. Leave blank to auto-generate + persist (output/.jwt_secret).
JWT_SECRET=

# ── Misc ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DRY_RUN=false
